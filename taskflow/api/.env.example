# For local API development, use the PostgreSQL port published by root compose.yaml.
# Keep the username, password, and database name in sync with the repository root .env.
DATABASE_URL="postgresql://taskflow:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5433/taskflow?schema=public"
# Use the same random JWT secret as the repository root .env when running the API locally.
JWT_ACCESS_TOKEN_SECRET=replace_with_64_random_hex_characters
