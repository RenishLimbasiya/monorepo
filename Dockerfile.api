FROM node:22-alpine AS build
WORKDIR /app
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?schema=public
COPY package.json package-lock.json ./
COPY taskflow/api/package.json ./taskflow/api/package.json
COPY taskflow/web/package.json ./taskflow/web/package.json
RUN npm ci
COPY taskflow/api ./taskflow/api
RUN npm run build -w @taskflow/api

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY taskflow/api/package.json ./taskflow/api/package.json
COPY taskflow/web/package.json ./taskflow/web/package.json
RUN npm ci --omit=dev --workspace=@taskflow/api --include-workspace-root=false && npm cache clean --force
COPY --from=build /app/taskflow/api/dist ./taskflow/api/dist
COPY --from=build /app/taskflow/api/prisma ./taskflow/api/prisma
COPY --from=build /app/taskflow/api/prisma.config.ts ./taskflow/api/prisma.config.ts
WORKDIR /app/taskflow/api
USER node
EXPOSE 3000
CMD ["sh", "-c", "npm run db:deploy && npm start"]
