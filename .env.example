# Copy this file to .env and replace the URL-safe password before starting Compose.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace_with_a_long_random_password_2026
WEB_PORT=80
API_PORT=3000
POSTGRES_PORT=5433
# Generate a unique 32-byte secret (64 hexadecimal characters) for JWT signing.
JWT_ACCESS_TOKEN_SECRET=replace_with_64_random_hex_characters
